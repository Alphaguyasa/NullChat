<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth, SDK 31+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Bluetooth, SDK 26-30. Required because minSdk is 26; the SDK 31+
         permissions above do not exist on these API levels. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLE scanning was location-gated through SDK 31 inclusive. Nearby
         Connections still requires this on Android 12 even alongside the new
         BLUETOOTH_* permissions, and refuses to start advertising or discovering
         without it; maxSdkVersion=30 silently breaks the app on Android 12.
         https://developers.google.com/nearby/connections/android/get-started -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="31" />
    <!-- Android 12 added the precise/approximate toggle: a FINE request without
         COARSE alongside it is denied outright by the system. -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="31" />

    <!-- Wi-Fi Direct / Nearby, SDK 33+ -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Install-time, not runtime, and required by Nearby Connections through
         SDK 31. Omitting these does not fail the build or the permission flow:
         startDiscovery just returns 8032 MISSING_PERMISSION_ACCESS_WIFI_STATE on
         every scan, which only shows up on a device. -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        android:maxSdkVersion="31" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_STATE"
        android:maxSdkVersion="31" />

    <!-- Background mesh operation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- SDK 33+. Not a mesh permission, but without it the foreground service's
         notification is never shown, and a service the user cannot see is one
         they cannot stop. Requested alongside the others, not enforced. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- QR pairing only. Requested at the pairing screen rather than in the
         app-wide permission gate: the mesh works perfectly well without a
         camera, and blocking launch on a permission most users never need would
         be disproportionate. See ui/permissions/MeshPermissions.kt. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Not required: a device with no camera can still display its own code
         for someone else to scan, which is half of pairing. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".NChatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NChat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NChat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice is the type that matches what this actually does;
             the platform rejects a mismatched type at startForeground time. -->
        <service
            android:name=".service.MeshForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
