<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup rules for devices below API 31. See data_extraction_rules.xml
   for 31+, which must be kept in step with this file.

   The identity keys must never leave the device. mesh_keys holds the Ed25519
   and X25519 private key material, sealed under an Android Keystore key that is
   itself never backed up — so a restored copy would be undecryptable anyway,
   but a private key has no business in a cloud backup at all.

   mesh_identity is the old placeholder identity's file, excluded so a restore
   cannot resurrect a stale id.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="mesh_keys.xml" />
    <exclude
        domain="sharedpref"
        path="mesh_identity.xml" />
</full-backup-content>
